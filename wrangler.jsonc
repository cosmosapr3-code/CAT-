{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "cat",
  "main": "./_worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cat-taisen-db",
      "database_id": "a8a6613b-5100-4bed-985e-a5b9490bf98d"
    }
  ]
}
